[Unit]
Description=Azure TTS Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/azure-tts-service
Environment="PATH=/opt/azure-tts-service/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/azure-tts-service/.env
ExecStart=/opt/azure-tts-service/venv/bin/uvicorn app:app --host 127.0.0.1 --port 12001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
